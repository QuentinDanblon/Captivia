# Captivia - variables Docker Compose
# Copiez ce fichier vers .env à la racine :
#   macOS/Linux : cp .env.example .env
#   Windows     : copy .env.example .env
# Docker Compose charge automatiquement .env.

POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=captivia
POSTGRES_PORT=5432

BACKEND_PORT=3001
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000

# Obligatoire en production : remplacez cette valeur par un secret aléatoire.
JWT_SECRET=dev-only-change-me-captivia-docker-secret-32-chars

# Cache local portable : Redis est démarré par Compose, mais la mémoire suffit par défaut.
CACHE_TYPE=memory
REDIS_ENABLED=false
REDIS_HOST=redis
REDIS_PORT=6379
LOG_LEVEL=info
LOG_FORMAT=json
SENTRY_DSN=

# Optionnel : permet de fournir une URL PostgreSQL complète à la place
# de la valeur construite par Compose.
# DOCKER_DATABASE_URL=postgresql://user:password@postgres:5432/captivia?schema=public

# Optionnel : intégrations externes
# SPECIESPLUS_API_TOKEN=
# AMAZON_ACCESS_KEY=
# AMAZON_SECRET_KEY=
# AMAZON_AFFILIATE_TAG=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:contact@captivia.com

# Utilisé uniquement par le script historique d'ouverture Vercel.
VERCEL_APP_URL=https://votre-projet.vercel.app
