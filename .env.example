# Captivia - variables Docker Compose
# Copiez ce fichier vers .env à la racine :
#   macOS/Linux : cp .env.example .env
#   Windows     : copy .env.example .env
# Docker Compose charge automatiquement .env.
#
# Les variables marquées OBLIGATOIRE n'ont volontairement AUCUNE valeur par défaut :
# `docker compose up` échoue tant qu'elles ne sont pas renseignées.

# ── Base de données ───────────────────────────────────────────────────────────
POSTGRES_USER=user
# OBLIGATOIRE : mot de passe PostgreSQL. Utilisez des caractères sûrs pour une URL
# (il est injecté dans DATABASE_URL), par ex. : openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=captivia
# Port publié sur 127.0.0.1 uniquement (jamais exposé au réseau).
POSTGRES_PORT=5432

# ── Ports et URLs ─────────────────────────────────────────────────────────────
BACKEND_PORT=3001
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001
# Origines autorisées par CORS (séparées par des virgules, sans slash final).
# Obligatoire en production (le conteneur backend tourne en NODE_ENV=production).
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
# URL du frontend (liens des e-mails). https obligatoire en production,
# sauf http://localhost / 127.0.0.1 pour la stack Docker locale.
FRONTEND_URL=http://localhost:3000
# URL publique du site (optionnel).
PUBLIC_WEB_URL=

# ── Sécurité ──────────────────────────────────────────────────────────────────
# OBLIGATOIRE : secret de signature des JWT, 32+ caractères aléatoires.
#   openssl rand -base64 48
# Les valeurs d'exemple (dev-only…, change-me…) sont refusées en production.
JWT_SECRET=
# Nombre de reverse proxies de confiance devant l'API : false (aucun), true (= 1) ou un entier.
# À renseigner UNIQUEMENT derrière un proxy de confiance (sinon l'IP client est falsifiable).
TRUST_PROXY=false
# E-mails des opérateurs (séparés par des virgules). Ce mécanisme peut être
# remplacé par un rôle en base de données : voir backend/.env.example.
OPERATOR_EMAILS=

# ── Cache / Redis ─────────────────────────────────────────────────────────────
# Cache local portable : Redis est démarré par Compose, mais la mémoire suffit par défaut.
CACHE_TYPE=memory
REDIS_ENABLED=false
REDIS_HOST=redis
REDIS_PORT=6379

# ── Logs / observabilité ──────────────────────────────────────────────────────
# error | warn | info | debug (le format JSON n'est pas supporté pour l'instant).
LOG_LEVEL=info
SENTRY_DSN=

# Optionnel : permet de fournir une URL PostgreSQL complète à la place
# de la valeur construite par Compose.
# DOCKER_DATABASE_URL=postgresql://user:<mot-de-passe>@postgres:5432/captivia?schema=public

# ── E-mail (réinitialisation de mot de passe) ─────────────────────────────────
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_SECURE=false
# MAIL_USER=
# MAIL_PASS=
# MAIL_FROM=Captivia <noreply@captivia.com>

# ── Intégrations externes (optionnel) ─────────────────────────────────────────
# SPECIESPLUS_API_TOKEN=
# AMAZON_ACCESS_KEY=
# AMAZON_SECRET_KEY=
# AMAZON_AFFILIATE_TAG=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:contact@captivia.com

# Utilisé uniquement par le script historique d'ouverture Vercel.
VERCEL_APP_URL=https://votre-projet.vercel.app
