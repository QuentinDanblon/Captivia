// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// Phase 0 - User & Auth
// ============================================

/// Rôle applicatif. OPERATOR ne s'obtient JAMAIS par inscription : uniquement
/// via `npm run operator:set` (scripts/set-operator.ts) — cf. W0-01.
enum UserRole {
  USER
  OPERATOR
}

model User {
  id           String   @id @default(uuid())
  /// Toujours normalisé (trim + minuscules) — CHECK SQL "User_email_normalized_check".
  email        String   @unique
  passwordHash String
  locale       String   @default("fr")
  /// Fuseau IANA (ex. "Europe/Paris") : sert au scheduler de rappels pour la « journée en cours » (W3-02).
  timezone     String   @default("Europe/Paris")
  isPremium    Boolean  @default(false)
  role         UserRole @default(USER)
  /// Incrémenté à chaque reset / changement de mot de passe : invalide les JWT émis avant.
  tokenVersion Int      @default(0)
  /// Consentement CGU + politique de confidentialité à l'inscription (W2-03)
  termsAcceptedAt DateTime? @db.Timestamptz(3)
  termsVersion    String?
  /// Date de vérification de l'adresse e-mail (W2-04) ; null = non vérifiée.
  emailVerifiedAt DateTime? @db.Timestamptz(3)
  points       Int      @default(0)   // Points pour le système de grade
  grade        String   @default("bronze") // bronze | silver | gold | platinum | diamond
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  // Relations
  animals                 Animal[]
  pushSubscriptions       PushSubscription[]
  notificationPreferences NotificationPreference[]
  notificationEvents      NotificationEvent[]
  passwordResetTokens     PasswordResetToken[]
  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  subscriptions           Subscription[]
  paymentEvents           PaymentEvent[]
}

// ============================================
// Achats intégrés (W6-08) — App Store / Google Play via RevenueCat
// ============================================

enum SubscriptionSource {
  APPLE
  GOOGLE
  MANUAL
}

enum SubscriptionStatus {
  ACTIVE
  IN_GRACE_PERIOD
  CANCELLED
  EXPIRED
  BILLING_ISSUE
  REFUNDED
}

enum SubscriptionEnvironment {
  SANDBOX
  PRODUCTION
}

/// Abonnement store (une ligne par achat d'origine). Donne accès au premium tant que
/// status ∈ {ACTIVE, IN_GRACE_PERIOD, CANCELLED} ET currentPeriodEnd > maintenant.
model Subscription {
  id                    String                  @id @default(uuid())
  userId                String
  source                SubscriptionSource
  productId             String
  entitlement           String                  @default("premium")
  status                SubscriptionStatus
  /// Identifiant de l'achat d'origine chez le store (stable entre renouvellements).
  originalTransactionId String
  currentPeriodEnd      DateTime?               @db.Timestamptz(3)
  willRenew             Boolean                 @default(false)
  environment           SubscriptionEnvironment @default(PRODUCTION)
  lastEventId           String?
  /// event_timestamp_ms du dernier événement appliqué : les événements plus anciens sont ignorés.
  lastEventAt           DateTime?               @db.Timestamptz(3)
  createdAt             DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([source, originalTransactionId])
  @@index([userId, status, currentPeriodEnd])
}

/// Journal des notifications de paiement reçues (idempotence par eventId).
/// userId passe à NULL à la suppression du compte (le payload ne contient pas d'e-mail).
model PaymentEvent {
  id         String   @id @default(uuid())
  provider   String
  eventId    String   @unique
  type       String
  userId     String?
  /// applied | duplicate | ignored_stale | ignored_unknown_user | ignored_entitlement | ignored_store | ignored_type
  outcome    String   @default("applied")
  payload    Json
  receivedAt DateTime @default(now()) @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([receivedAt])
}

/// Refresh token opaque (W1-01) : seul sha256(token) est stocké. Rotation à chaque
/// /auth/refresh ; la réutilisation d'un token déjà roté révoque toute la famille.
model RefreshToken {
  id           String    @id @default(uuid())
  userId       String
  /// sha256(token) en hexadécimal : le token en clair n'est jamais stocké.
  tokenHash    String    @unique
  /// Identifiant de la chaîne de rotation (une famille = une session / un appareil).
  familyId     String
  expiresAt    DateTime  @db.Timestamptz(3)
  revokedAt    DateTime? @db.Timestamptz(3)
  /// Token émis en remplacement lors de la rotation (null = token courant de la famille).
  replacedById String?
  userAgent    String?
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

/// Token de vérification d'e-mail (W2-04), haché (sha256), valable 24 h.
model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  /// sha256(token) en hexadécimal : le token en clair n'est jamais stocké.
  tokenHash String   @unique
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ============================================
// Phase 2 - Animals & Routines
// ============================================

model Animal {
  id         String    @id @default(uuid())
  userId     String
  speciesId  Int // GBIF key
  name       String
  birthDate  DateTime? @db.Timestamptz(3)
  sex        String?
  photos     String[] // URLs
  notes      String?
  publicSlug String?   @unique // slug pour page publique / QR (Premium)
  // W0-06 — partage public (QR) en opt-in : désactivé par défaut, révocable (regénération du slug)
  publicEnabled    Boolean @default(false)
  publicShowHealth Boolean @default(false) // affiche les vaccinations (nom + date) sur la page publique
  // Module F — parenté & groupement (éleveurs)
  fatherId  String? // FK -> Animal.id (père, SetNull à la suppression)
  motherId  String? // FK -> Animal.id (mère, SetNull à la suppression)
  groupName String? // Enclos / groupe libre (max 100 chars, CHECK SQL)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)

  // Relations
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  speciesProfile     SpeciesProfile       @relation(fields: [speciesId], references: [speciesId], onDelete: Restrict)
  routines           Routine[]
  history            ActionLog[]
  healthRecords      AnimalHealthRecord[]
  medications        Medication[]
  vetAppointments    VetAppointment[]
  measurements       AnimalMeasurement[]
  vaccinations       Vaccination[]
  breedingRecords    BreedingRecord[]
  notificationEvents NotificationEvent[]
  // Module F — auto-relations parenté
  father         Animal?  @relation("Father", fields: [fatherId], references: [id], onDelete: SetNull)
  mother         Animal?  @relation("Mother", fields: [motherId], references: [id], onDelete: SetNull)
  childrenFather Animal[] @relation("Father")
  childrenMother Animal[] @relation("Mother")

  @@index([userId])
  @@index([speciesId])
  @@index([fatherId])
  @@index([motherId])
  @@index([groupName])
}

// Carnet de santé : vaccin, opération, nourriture spécifique, antécédant médical, intervention chirurgicale
model AnimalHealthRecord {
  id        String   @id @default(uuid())
  animalId  String
  type      String   // vaccine | surgery | specific_food | medical_history
  title     String   // ex. "Vaccin rage", "Stérilisation"
  date      DateTime @db.Timestamptz(3) // date de l'événement
  notes     String?  // description libre
  details   Json?    // infos complémentaires (vétérinaire, prochain rappel, etc.)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  animal Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)

  @@index([animalId])
  @@index([animalId, type])
}

model Routine {
  id        String   @id @default(uuid())
  animalId  String
  name      String?  // Optional custom name for the routine
  type      String // nourrissage, entretien, uvb, controle
  frequency String // daily, weekly, custom
  schedule  Json // horaires, saison, paramètres personnalisés
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  // Relations
  animal             Animal               @relation(fields: [animalId], references: [id], onDelete: Cascade)
  notificationEvents NotificationEvent[]

  @@index([animalId])
  @@index([active])
  @@index([animalId, active])
}

// Module A — Rappels de médicaments (Premium)
model Medication {
  id            String    @id @default(uuid())
  animalId      String
  name          String
  dose          String
  unit          String?
  frequency     String // daily | every_x_hours | weekly
  intervalHours Int?      // requis si frequency = every_x_hours
  startDate     DateTime  @db.Timestamptz(3)
  endDate       DateTime? @db.Timestamptz(3)
  notes         String?
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

  // Relations
  animal             Animal               @relation(fields: [animalId], references: [id], onDelete: Cascade)
  notificationEvents NotificationEvent[]

  @@index([animalId])
  @@index([animalId, active])
}

// Module A — Rendez-vous vétérinaires (Premium)
model VetAppointment {
  id           String    @id @default(uuid())
  animalId     String
  vetName      String
  reason       String?
  date         DateTime  @db.Timestamptz(3)
  location     String?
  notes        String?
  status       String    @default("scheduled") // scheduled | done | cancelled
  reminderDays Int[]     @default([7, 1]) // jours avant le RDV pour les rappels (J-N)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  // Relations
  animal             Animal               @relation(fields: [animalId], references: [id], onDelete: Cascade)
  notificationEvents NotificationEvent[]

  @@index([animalId])
  @@index([animalId, status])
}

// Module C — Mesures poids/taille (carnet de santé enrichi, Premium)
model AnimalMeasurement {
  id         String   @id @default(uuid())
  animalId   String
  weightKg   Float? // kg (optionnel si heightCm renseigné)
  heightCm   Float? // cm (optionnel si weightKg renseigné)
  measuredAt DateTime @db.Timestamptz(3)
  notes      String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  // Relations
  animal Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)

  @@index([animalId])
  @@index([animalId, measuredAt])
}

// Module C — Vaccinations structurées avec rappel de rappel (Premium)
model Vaccination {
  id          String    @id @default(uuid())
  animalId    String
  name        String    // ex. 'Rage'
  date        DateTime  @db.Timestamptz(3) // date du vaccin
  nextDueDate DateTime? @db.Timestamptz(3) // date du prochain rappel (génère un événement de rappel)
  batchNumber String?   // n° de lot
  vetName     String?   // vétérinaire ayant administré
  notes       String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  // Relations
  animal             Animal               @relation(fields: [animalId], references: [id], onDelete: Cascade)
  notificationEvents NotificationEvent[]

  @@index([animalId])
}

// Module D — Modèles de routines par défaut par espèce (proposés à la création d'un animal)
// Pas de FK : cohérence par speciesId (GBIF key), comme les autres tables Species*.
model SpeciesRoutineTemplate {
  id        String   @id @default(uuid())
  speciesId Int // GBIF key
  type      String // nourrissage, entretien, uvb, controle
  name      String?
  frequency String // daily, weekly, monthly, once, hourly, custom, every_2_days, every_3_days
  schedule  Json // format frontend : { time: "08:00", recurrence: "daily", ... }
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([speciesId, type, order])
  @@index([speciesId])
}

// Module B — Suivi de reproduction par animal (Premium)
model BreedingRecord {
  id             String   @id @default(uuid())
  animalId       String
  eventType      String   // heat | mating | pregnancy | birth | weaning
  date           DateTime @db.Timestamptz(3) // date de l'événement
  partnerName    String?  // nom / identifiant du partenaire
  offspringCount Int?     // nombre de petits (requis si eventType = birth)
  notes          String?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  // Relations
  animal Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)

  @@index([animalId])
  @@index([animalId, date])
}

model ActionLog {
  id       String   @id @default(uuid())
  animalId String
  type     String
  note     String?
  doneAt   DateTime @default(now()) @db.Timestamptz(3)

  // Relations
  animal Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)

  @@index([animalId])
  @@index([doneAt])
  @@index([animalId, doneAt])
}

// ============================================
// Phase 3 - Notifications
// ============================================

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  keys      Json // { p256dh, auth }
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, endpoint])
}

model NotificationPreference {
  id               String   @id @default(uuid())
  userId           String   @unique
  types            Json // { "Nourrissage": true, "Rappel véto": true }
  typeSchedules    Json?    // { "Nourrissage": { time: "08:00", recurrence: "daily" }, ... }
  schedule         Json // { start: "08:00", end: "22:00" } (fenêtre globale)
  snooze           Int      @default(15) // minutes
  deliveryChannel  String   @default("push") // "push" | "email" | "both" — téléphone (push) et/ou email
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Événements de rappel : un par notification envoyée / à faire, pour Fait / Pas fait et points
model NotificationEvent {
  id             String   @id @default(uuid())
  userId         String
  type           String   // ex: "Nourrissage", "Bain"
  label          String?  // libellé affiché
  scheduledAt    DateTime @db.Timestamptz(3)
  status         String   @default("pending") // pending | done | skipped
  pointsAwarded  Int      @default(0) // 100 si done
  routineId      String?  // optionnel : lien vers une routine (animal)
  medicationId   String?  // optionnel : lien vers un rappel de médicament (Module A)
  appointmentId  String?  // optionnel : lien vers un RDV vétérinaire (Module A)
  vaccinationId  String?  // optionnel : lien vers un rappel vaccin (Module C)
  animalId       String?  // optionnel : animal concerné
  // W0-07 — clé d'idempotence : "routine:<id>" | "medication:<id>" | "appointment:<id>" | "vaccination:<id>" | "pref:<type>".
  // Nullable : les anciens créateurs d'événements sans clé ne sont pas dédupliqués (NULL distincts en SQL).
  sourceKey      String?
  /// W3-02 — posé atomiquement par le scheduler quand le rappel a été envoyé (anti-doublon).
  notifiedAt     DateTime? @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  // Relations
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  routine      Routine?       @relation(fields: [routineId], references: [id], onDelete: SetNull)
  medication   Medication?    @relation(fields: [medicationId], references: [id], onDelete: SetNull)
  appointment  VetAppointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  vaccination  Vaccination?   @relation(fields: [vaccinationId], references: [id], onDelete: SetNull)
  animal       Animal?        @relation(fields: [animalId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([scheduledAt])
  @@index([userId, scheduledAt])
  @@index([routineId])
  @@index([medicationId])
  @@index([appointmentId])
  @@index([vaccinationId])
  @@index([userId, status, scheduledAt])
  @@unique([userId, sourceKey, scheduledAt])
}

// ============================================
// Phase 1 - Editorial Content (optional tables)
// ============================================

// ============================================
// Phase 1b - Species Data (Editorial Content)
// ============================================

model SpeciesProfile {
  id                  String    @id @default(uuid())
  speciesId           Int       @unique // GBIF key (ou ID artificiel ≥ 2 000 000 001 pour les races)
  commonNameFr        String    // Nom commun français (ex: "Chat", "Python royal", "Berger allemand")
  scientificName      String    // Nom scientifique (ex: "Felis catus", "Canis lupus familiaris")
  category            String    // Catégorie principale (mammifère, reptile, amphibien, oiseau, poisson, insecte, arachnide)
  subcategory         String?   // Sous-catégorie (ex: "Carnivore, Félidé", "Serpent constricteur", "Chien de berger")
  domesticationType   String    // Type de domestication (domestique, semi-domestique, NAC)
  description         String?   // Description courte (max 500 chars)
  sourceUrl           String?   // URL de la source de la description (Wikipedia FR ou guide spécialisé)
  createdAt           DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(3)

  // Relations
  animals Animal[]

  @@index([category])
  @@index([domesticationType])
}

model SpeciesFeeding {
  id                 String   @id @default(uuid())
  speciesId          Int      // GBIF key (ou ID artificiel ≥ 2 000 000 001 pour les races)
  locale             String   @default("fr")
  dietType           String   // herbivore, carnivore, omnivore, insectivore, etc.
  recommendedFoods   Json     // Array of { name, frequency, notes } ex: [{ name: "Laitue", frequency: "quotidien", notes: "Aliment principal" }]
  foodsToAvoid       Json     // Array of { name, reason } ex: [{ name: "Avocat", reason: "Toxique pour cette espèce" }]
  mealFrequency      String   // "daily", "every_2_days", "weekly", "variable", etc.
  specificNeeds      String?  // Besoins spécifiques en protéines, vitamines, calcium, etc. (max 500 chars)
  sources            Json?    // Array of { type: 'vet'|'guide'|'manufacturer'|'wikipedia', url, title } — traçabilité
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)

  @@unique([speciesId, locale])
  @@index([speciesId])
  @@index([dietType])
}

model SpeciesHabitat {
  id                   String   @id @default(uuid())
  speciesId            Int      // GBIF key (ou ID artificiel ≥ 2 000 000 001 pour les races)
  locale               String   @default("fr")
  habitatType          String   // "cage", "terrarium", "aquarium", "enclos", "libre", etc.
  tempMin              Float    // Température minimale (Celsius)
  tempMax              Float    // Température maximale (Celsius)
  humidityMin          Float?   // Humidité minimale (%)
  humidityMax          Float?   // Humidité maximale (%)
  minSpaceSize         String   // Taille minimale d'espace recommandée (ex: "60x40x40cm" ou "2m²")
  lightNeeds           String   // Besoins en lumière (naturelle, UV, cycle jour/nuit, etc.)
  activityEnrichment   String   // Niveau d'activité et enrichissement nécessaire (max 500 chars)
  hygieneNotes         String?  // Notes sur l'entretien et l'hygiène (max 500 chars)
  costEstimate         String   // "faible", "moyen", "élevé"
  sources              Json?    // Array of { type, url, title } — traçabilité
  createdAt            DateTime @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @db.Timestamptz(3)

  @@unique([speciesId, locale])
  @@index([speciesId])
  @@index([habitatType])
}

model SpeciesBehavior {
  id                           String   @id @default(uuid())
  speciesId                    Int      // GBIF key (ou ID artificiel ≥ 2 000 000 001 pour les races)
  locale                       String   @default("fr")
  generalBehavior              String   // Description générale du comportement (max 500 chars)
  sociability                  String   // "solitaire", "grégaire", "semi-grégaire"
  difficultyLevel              String   // "débutant", "intermédiaire", "expert"
  compatibilityWithChildren    String?  // Description de la compatibilité avec enfants (max 500 chars)
  compatibilityWithOtherAnimals String? // Description de la compatibilité avec autres animaux (max 500 chars)
  sources                      Json?    // Array of { type, url, title } — traçabilité
  createdAt                    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt                    DateTime @updatedAt @db.Timestamptz(3)

  @@unique([speciesId, locale])
  @@index([speciesId])
  @@index([difficultyLevel])
}

model SpeciesHealthContent {
  id          String   @id @default(uuid())
  speciesId   Int // GBIF key
  locale      String   @default("fr")
  diseases    Json // Array of { name, symptoms, prevention, whenToConsult }
  sources     Json // Array of { type: 'pubmed'|'lafebervet'|'ivis', url, title }
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@unique([speciesId, locale])
  @@index([speciesId])
}

model SpeciesLegislation {
  id          String   @id @default(uuid())
  speciesId   Int // GBIF key
  country     String // ISO code (FR, US, GB, etc.)
  status      String // allowed, prohibited, permit_required
  details     Json // { citesAppendix, euAnnex, permits, restrictions }
  sources     String[] // URLs to official sources
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@unique([speciesId, country])
  @@index([speciesId])
  @@index([country])
}

// Module B — Fiche reproduction par espèce (contenu éditorial, rempli par le Module E)
model SpeciesReproduction {
  id                   String   @id @default(uuid())
  speciesId            Int      // GBIF key (ou ID artificiel ≥ 2 000 000 001 pour les races)
  locale               String   @default("fr")
  season               String?  // saison de reproduction (ex: "printemps")
  gestationDays        Int?     // durée de gestation (jours)
  incubationDays       Int?     // durée d'incubation (jours)
  litterSizeMin        Int?     // taille de portée min
  litterSizeMax        Int?     // taille de portée max
  sexualMaturityMonths Int?     // maturité sexuelle (mois)
  breedingDifficulty   String?  // facile | modere | avance
  notes                String?  // notes complémentaires
  sources              Json?    // Array of { type, url, title } — traçabilité
  createdAt            DateTime @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @db.Timestamptz(3)

  @@unique([speciesId, locale])
  @@index([speciesId])
}

model RecommendedEquipment {
  id          String   @id @default(uuid())
  speciesId   Int? // GBIF key (null = general category)
  category    String // chauffage, uvb, substrat, alimentation, cage, etc.
  label       String // "Gamelle inox 2L", "Lampe UVB 10.0"
  size        String? // small, medium, large (for animals)
  searchTerms String[] // Keywords for Amazon/product search
  order       Int      @default(0)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([speciesId])
  @@index([category])
}

// Magasins / liens d'affiliation par catégorie d'espèce (NAC, chien, reptile, etc.)
model AffiliateStore {
  id          String   @id @default(uuid())
  name        String   // Nom du magasin ou de l'offre
  url         String   // Lien affiliation (croquettes, matériel, etc.)
  description String?  // Courte description (ex: "Croquettes et matériel pour chien")
  categories  String[] // Catégories d'espèces: mammifère, reptile, oiseau, poisson, amphibien, insecte, arachnide
  types       String[] // Types d'offre: alimentation, materiel, general
  order       Int      @default(0)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([categories])
  @@index([categories], type: Gin, map: "AffiliateStore_categories_gin_idx")
  @@index([types], type: Gin, map: "AffiliateStore_types_gin_idx")
}
