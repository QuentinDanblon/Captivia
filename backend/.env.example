# Database Configuration
DATABASE_URL="postgresql://user:***@localhost:5432/captivia?schema=public"

# Server Configuration (backend: 3001, frontend Next.js: 3000)
PORT=3001
# HOST=0.0.0.0  # optionnel : écoute sur toutes les interfaces (pour accès téléphone)

# CORS : origines autorisées (séparées par des virgules, SANS slash final)
# Requis en production. En dev, si absent : http://localhost:3000,http://127.0.0.1:3000
# (jamais '*' avec credentials ; l'auth passe par header Bearer, pas de cookies)
CORS_ORIGIN="http://localhost:3000,http://127.0.0.1:3000"

# Trust proxy : mettre à true UNIQUEMENT derrière un reverse proxy de confiance
# (nginx, traefik…) qui gère X-Forwarded-For. Sinon laisser false, sinon les clients
# pourraient spoof leur IP et contourner le rate limiting.
TRUST_PROXY=false

# Wikipedia API Configuration (free, no API key required)
WIKIPEDIA_API_BASE_URL="https://en.wikipedia.org/api/rest_v1"
WIKIPEDIA_RATE_LIMIT=100
WIKIPEDIA_RATE_WINDOW=60000

# Wikidata API Configuration (free, no API key required)
WIKIDATA_API_BASE_URL="https://query.wikidata.org/sparql"
WIKIDATA_RATE_LIMIT=100
WIKIDATA_RATE_WINDOW=60000

# Cache Configuration
# Choose cache implementation: 'redis', 'memcached', or 'memory'
CACHE_TYPE="memory"

# Redis Configuration (if CACHE_TYPE=redis)
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# TTL de cache par type de données (en secondes)
CACHE_TTL_SPECIES=86400        # 24h — fiches espèces
CACHE_TTL_MEDIA=3600           # 1h — médias
CACHE_TTL_DISTRIBUTIONS=86400  # 24h — distributions
CACHE_TTL_VERNACULAR=43200     # 12h — noms vernaculaires
CACHE_TTL_METRICS=604800       # 7j — métriques / occurrences
CACHE_TTL_SEARCH=3600          # 1h — recherches
CACHE_TTL=3600                 # TTL par défaut (fallback)

# Memcached Configuration (if CACHE_TYPE=memcached)
MEMCACHED_HOST=localhost
MEMCACHED_PORT=11211

# API Rate Limiting
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_TTL=3600

# Logging
LOG_LEVEL="info"
LOG_FORMAT="json"

# Sentry (observabilité) : laisser vide pour désactiver (aucun impact runtime).
# DSN du projet Sentry (https://<org>.ingest.sentry.io/<project>) pour activer
# la capture des exceptions serveur (filtre global + handlers process).
SENTRY_DSN=

# JWT Configuration (REQUIRED - use a strong random string of 32+ chars)
# NB: la durée de validité est fixée à 7j dans src/auth/auth.module.ts (expiresIn)
JWT_SECRET="change-me-to-a-strong-random-secret-at-least-32-chars"

# Opérateur(s) : email(s) avec accès complet sans abonnement (séparés par des virgules)
OPERATOR_EMAILS="op1@example.com,op2@example.com"
# (l'ancienne variable OPERATOR_EMAIL reste acceptée comme fallback)

# Species+ API Configuration
SPECIESPLUS_API_TOKEN="your-token-here"

# Amazon Product Advertising API Configuration
AMAZON_ACCESS_KEY="your-access-key"
AMAZON_SECRET_KEY="your-secret-key"
AMAZON_AFFILIATE_TAG="your-affiliate-tag"
AMAZON_MARKETPLACE="www.amazon.com"

# Push Notifications Configuration (Web Push VAPID)
VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_SUBJECT="mailto:contact@captivia.com"

# Password reset email (optional; if not set, reset link is logged to console)
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_SECURE=false   # true si port 465 (TLS implicite), false pour STARTTLS sur 587
# MAIL_USER=your-email@example.com
# MAIL_PASS=your-password
# MAIL_FROM=Captivia <noreply@captivia.com>
# URL du frontend pour le lien de réinitialisation (frontend Next.js : 3000, backend : 3001)
FRONTEND_URL=http://localhost:3000

# GBIF API : l'URL de base est codée en dur dans le code (https://api.gbif.org/v1) — pas de variable.
