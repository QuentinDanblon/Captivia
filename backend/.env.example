# Captivia backend - variables d'environnement (hors Docker Compose).
# Copiez vers backend/.env. Les variables validées au démarrage (src/config/env.validation.ts)
# sont marquées « requis » ; en NODE_ENV=production les règles sont plus strictes.

# ── Runtime ───────────────────────────────────────────────────────────────────
# development | test | production
NODE_ENV=development

# ── Base de données (requis) ──────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/captivia?schema=public"

# ── Serveur ───────────────────────────────────────────────────────────────────
# Backend : 3001, frontend Next.js : 3000.
PORT=3001
# Interface d'écoute. Défaut : 0.0.0.0 (IPv4, fonctionne partout).
# Mettre :: pour du dual-stack IPv4+IPv6 si l'hôte supporte IPv6.
# HOST=0.0.0.0

# CORS : origines autorisées (séparées par des virgules, SANS slash final).
# REQUIS en production. En dev, si absent : http://localhost:3000,http://127.0.0.1:3000
# (jamais '*' ; l'auth passe par header Bearer, pas de cookies)
CORS_ORIGIN="http://localhost:3000,http://127.0.0.1:3000"

# URL du frontend (liens des e-mails de réinitialisation, etc.).
# REQUIS en production et en https (sauf http://localhost pour un test local).
FRONTEND_URL=http://localhost:3000
# URL publique du site (optionnel, doit être une URL valide si définie).
# PUBLIC_WEB_URL=https://captivia.example

# Trust proxy : nombre de reverse proxies de confiance devant l'API.
#   false (défaut) = aucun ; true = 1 saut ; entier N = N sauts (ex. CDN + load balancer).
# À définir UNIQUEMENT derrière un proxy de confiance qui gère X-Forwarded-For,
# sinon les clients pourraient falsifier leur IP et contourner le rate limiting.
TRUST_PROXY=false

# ── Authentification ──────────────────────────────────────────────────────────
# REQUIS. Secret de signature des JWT.
#   Générez-le : openssl rand -base64 48
# En production : 32 caractères minimum et valeurs d'exemple (dev-only…, change-me…) refusées.
# (hors production : 16 caractères minimum.)
# NB : la durée de validité est fixée dans src/auth/auth.module.ts (expiresIn)
JWT_SECRET=

# Opérateurs : rôle en base (User.role). Promouvoir un compte existant :
#   cd backend && npm run operator:set -- <email>   (OPERATOR_EMAILS n'est plus lu)

# ── E-mail (réinitialisation de mot de passe, rappels de soin) ────────────────
# Sans MAIL_HOST : jsonTransport, rien n'est envoyé (message journalisé en debug hors prod).
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_SECURE=false   # true si port 465 (TLS implicite), false pour STARTTLS sur 587
# MAIL_USER=your-email@example.com
# MAIL_PASS=your-password
# MAIL_FROM=Captivia <noreply@captivia.com>

# ── Rappels (scheduler toutes les 5 min, W3-02) ───────────────────────────────
# false pour désactiver le job (toujours désactivé si NODE_ENV=test).
# REMINDERS_ENABLED=true

# ── Cache ─────────────────────────────────────────────────────────────────────
# Implémentation : memory | redis | memcached
CACHE_TYPE=memory

# Redis (si CACHE_TYPE=redis ou REDIS_ENABLED=true)
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Memcached (si CACHE_TYPE=memcached)
MEMCACHED_HOST=localhost
MEMCACHED_PORT=11211

# TTL de cache par type de données (en SECONDES)
CACHE_TTL_SPECIES=86400        # 24h : fiches espèces
CACHE_TTL_MEDIA=3600           # 1h : médias
CACHE_TTL_DISTRIBUTIONS=86400  # 24h : distributions
CACHE_TTL_VERNACULAR=43200     # 12h : noms vernaculaires
CACHE_TTL_METRICS=604800       # 7j : métriques / occurrences
CACHE_TTL_SEARCH=3600          # 1h : recherches
CACHE_TTL=3600                 # TTL par défaut (fallback)

# ── API externes (gratuites, sans clé) ────────────────────────────────────────
WIKIPEDIA_API_BASE_URL="https://en.wikipedia.org/api/rest_v1"
WIKIPEDIA_RATE_LIMIT=100
WIKIPEDIA_RATE_WINDOW=60000

WIKIDATA_API_BASE_URL="https://query.wikidata.org/sparql"
WIKIDATA_RATE_LIMIT=100
WIKIDATA_RATE_WINDOW=60000

# GBIF : l'URL de base est codée en dur dans le code (https://api.gbif.org/v1), pas de variable.

# Rate limiting applicatif (rate-limiter-flexible)
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_TTL=3600

# ── API externes avec identifiants (optionnel) ────────────────────────────────
# Species+ (CITES) : ne jamais logger ce token.
# SPECIESPLUS_API_TOKEN=
# Amazon Product Advertising API
# AMAZON_ACCESS_KEY=
# AMAZON_SECRET_KEY=
# AMAZON_AFFILIATE_TAG=
AMAZON_MARKETPLACE="www.amazon.com"

# Notifications push (Web Push VAPID)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT="mailto:contact@captivia.com"

# ── Logs / observabilité ──────────────────────────────────────────────────────
# error | warn | log (alias : info) | debug | verbose.
# Production : JSON sur stdout (pino) avec x-request-id ; dev : pino-pretty.
LOG_LEVEL="info"

# Sentry : laisser vide pour désactiver (aucun impact runtime).
# DSN du projet (https://<org>.ingest.sentry.io/<project>) pour activer la capture
# des exceptions serveur (filtre global + handlers process).
SENTRY_DSN=
# Part des transactions tracées (0 à 1, défaut 0.1). Version = RENDER_GIT_COMMIT ou GIT_SHA.
# SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Achats intégrés App Store / Google Play via RevenueCat (W6-08, docs/PAYMENTS.md) ---
# true en production dès que l'app mobile vend l'abonnement : REVENUECAT_WEBHOOK_SECRET devient obligatoire.
IAP_ENABLED=false
# Secret partagé (≥ 32 caractères, ex. openssl rand -hex 32) saisi dans RevenueCat > Integrations >
# Webhooks > Authorization header : « Bearer <secret> ». Sans lui, POST /webhooks/revenuecat répond 401.
REVENUECAT_WEBHOOK_SECRET=
# Identifiant de l'entitlement RevenueCat qui ouvre le premium (défaut : premium).
# REVENUECAT_ENTITLEMENT_ID=premium
# Nom de package Android (lien « Gérer mon abonnement » Google Play), ex. com.captivia.app
# GOOGLE_PLAY_PACKAGE_NAME=
